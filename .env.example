# Copy to .env and adjust. Every variable is parsed and validated in apps/api/src/config/envs.ts.
# Commented values are the defaults; production defaults differ where noted.

# --- App ---
NODE_ENV=development            # development | production | test
# HOST=0.0.0.0
PORT=3000
# API_PREFIX=api
# CORS_ORIGINS=*                # comma-separated; default "*" in dev, none in production

# --- Logging ---
LOG_LEVEL=debug                 # fatal | error | warn | log | debug | verbose (default: log in production)
LOG_FORMAT=pretty               # pretty | json (default: json in production)
# LOG_COLORS=true               # ignored when LOG_FORMAT=json
# LOG_HTTP_REQUESTS=true

# --- Swagger ---
# SWAGGER_ENABLED=true          # default false in production
# SWAGGER_PATH=docs             # -> /api/docs
# SWAGGER_TITLE=Turizm API
# SWAGGER_VERSION=1.0.0

# --- File uploads (multer) ---
# UPLOAD_DIR=uploads            # relative to the process cwd
# UPLOAD_MAX_FILE_SIZE_MB=10
# UPLOAD_MAX_FILES=10
# UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf   # image/* wildcards allowed

# --- Redis / background jobs (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# JOBS_PREFIX=turizm
# JOBS_WORKER_ENABLED=true      # false = this instance only enqueues jobs
# JOBS_CONCURRENCY=5
# JOBS_ATTEMPTS=3
# JOBS_BACKOFF_MS=5000

# --- Database (PostgreSQL + Prisma) ---
# Special characters in the password must be URL-encoded (@ -> %40).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turizm?schema=public
# Only for `prisma migrate dev` when the DB user has no CREATEDB permission: an empty database used as shadow.
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turizm_shadow?schema=public

# --- Auth (JWT) ---
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# JWT_ACCESS_EXPIRES_IN=15m     # number of seconds or a duration: 30s, 15m, 12h, 7d
# JWT_REFRESH_EXPIRES_IN=30d
